# ===========================================================================
# RAG SYSTEM - configuration template
# Copy to ".env" and fill in.  NEVER commit the real .env file.
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------------
# Instance:  "localhost", ".\SQLEXPRESS", "10.0.0.5,1433", "srv.company.local"
MSSQL_SERVER=.\SQLEXPRESS
MSSQL_DATABASE=YourDatabase
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# Auth mode:  "windows"  -> integrated auth, no password stored anywhere (safest)
#             "sql"      -> SQL login, requires MSSQL_USERNAME / MSSQL_PASSWORD
MSSQL_AUTH_MODE=windows
MSSQL_USERNAME=
MSSQL_PASSWORD=

# TLS. Keep ENCRYPT=true always.
# TRUST_SERVER_CERTIFICATE=true is acceptable ONLY for a local dev instance
# using a self-signed cert. Set it to false against any real/remote server.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Ollama (local LLM - nothing leaves this machine)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT=240
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# Vector store (ChromaDB, on-disk)
# ---------------------------------------------------------------------------
CHROMA_PATH=./data/chroma
N_RESULTS=10

# ---------------------------------------------------------------------------
# Safety guardrails
# ---------------------------------------------------------------------------
# READ_ONLY=true blocks any generated SQL that is not a SELECT/CTE/read.
READ_ONLY=true
MAX_ROWS=1000
ALLOW_LLM_TO_SEE_DATA=false

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Set to true to print full LLM prompts to the console (debugging).
VERBOSE=false
