# ===========================================================================
# Local Enterprise Intelligence Copilot - configuration template
#
#   Copy to .env and edit:   Copy-Item .env.example .env
#
# The real .env is gitignored. Never commit credentials.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Model profile: lite | standard | high   (see config/profiles.py)
#   lite      CPU-friendly, 3B chat model, no reranker
#   standard  8B chat model + reranker, fits in 8 GB VRAM   <- default
#   high      14B chat model, needs >8 GB VRAM or offloads to RAM
COPILOT_PROFILE=standard

# Demo mode shrinks expensive steps so the notebook runs quickly.
COPILOT_DEMO_MODE=false

# Fixed seed makes synthetic data generation reproducible. Do not change it
# unless you intend to regenerate the whole dataset.
COPILOT_SEED=20240601

# ---------------------------------------------------------------------------
# SQL Server
# ---------------------------------------------------------------------------
# Examples:  .\SQLEXPRESS   localhost   localhost,1433   SERVER\INSTANCE
MSSQL_SERVER=.\SQLEXPRESS
MSSQL_DATABASE=EnterpriseCopilot
MSSQL_DRIVER=ODBC Driver 18 for SQL Server

# windows = integrated auth (no password stored anywhere)
# sql     = SQL login; REQUIRES the server to be in Mixed Mode.
#           See docs/security.md before switching.
MSSQL_AUTH_MODE=windows
MSSQL_USERNAME=
MSSQL_PASSWORD=

# Keep ENCRYPT=true. TRUST_SERVER_CERTIFICATE=true is acceptable only for a
# local instance with a self-signed certificate; set it false for any remote
# server, otherwise the connection can be intercepted.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_CONNECT_TIMEOUT=30
MSSQL_QUERY_TIMEOUT_SECONDS=30
MSSQL_MAX_RESULT_ROWS=5000

# ---------------------------------------------------------------------------
# Ollama (local inference - nothing leaves this machine)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=5m

# Leave blank to use the active profile's models. Set to override.
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Text-to-SQL provider
# ---------------------------------------------------------------------------
# vanna        local Vanna: Chroma store + Ollama, nothing leaves the machine
# native       the in-repo reference implementation, same guards
# vanna_cloud  Vanna Cloud (ask.vanna.ai) - SENDS DATA OFF THE MACHINE
TEXT_TO_SQL_PROVIDER=vanna

# ---------------------------------------------------------------------------
# Vanna Cloud
#
# Only read when TEXT_TO_SQL_PROVIDER=vanna_cloud. Leave VANNA_API_KEY blank
# and this whole section is inert.
#
# READ docs/vanna_cloud.md FIRST. Enabling this changes what the project
# claims about privacy: the schema, the business glossary, the approved SQL
# examples and every question are sent to a third party. Query results are
# not, and MUST not be - see VANNA_ALLOW_LLM_TO_SEE_DATA below.
# ---------------------------------------------------------------------------
VANNA_API_KEY=

# The corpus name in the Vanna dashboard. Vanna calls a training corpus a
# "model", which is confusing next to an LLM - this is not a language model.
VANNA_MODEL=enterprise-copilot

# hybrid  Vanna Cloud stores and retrieves the corpus; the LOCAL model
#         generates the SQL. Needs Ollama running.
# cloud   Vanna's hosted model generates as well. Required in a container
#         with no GPU, because there is no local model to call.
VANNA_MODE=hybrid

VANNA_ENDPOINT=https://ask.vanna.ai/rpc

# Keep this false. True sends query RESULTS - real customer rows - to Vanna
# so the model can refine a follow-up. The privacy claim in docs/security.md
# depends on it being false.
VANNA_ALLOW_LLM_TO_SEE_DATA=false

# ---------------------------------------------------------------------------
# Qdrant vector store
# ---------------------------------------------------------------------------
# embedded = in-process, local path, no Docker required   <- default
# server   = connect to a running Qdrant at QDRANT_URL
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_documents

# Bump when chunking or the embedding model changes, so a stale index is
# never queried by a newer configuration.
QDRANT_INDEX_VERSION=v1

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
RETRIEVAL_CHUNK_TARGET_TOKENS=400
RETRIEVAL_CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_CHUNK_MIN_TOKENS=50
RETRIEVAL_RRF_K=60
RETRIEVAL_ENABLE_QUERY_REWRITING=true
RETRIEVAL_ENABLE_RERANKING=true
RETRIEVAL_ENABLE_PARENT_EXPANSION=true
RETRIEVAL_MMR_LAMBDA=0.7

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECURITY_REQUIRE_SQL_APPROVAL=false
SECURITY_ENFORCE_TENANT_ISOLATION=true
SECURITY_MAX_SQL_JOINS=8

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OBS_ENABLE_TRACING=true
OBS_ENABLE_PHOENIX=false
OBS_PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
OBS_LOG_LEVEL=INFO
OBS_LOG_FORMAT=console
