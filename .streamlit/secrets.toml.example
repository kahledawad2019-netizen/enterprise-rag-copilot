# =============================================================================
# Streamlit secrets for cloud/streamlit/streamlit_app.py
#
# HOW TO USE
#   Streamlit Community Cloud:
#     Manage app -> Settings -> Secrets -> paste this whole file,
#     then replace every [BRACKETED] value (remove the brackets too).
#   Running locally:
#     copy this file to .streamlit/secrets.toml (same folder) and fill it in.
#     .streamlit/secrets.toml is git-ignored; never commit a real key.
#
# The key is read only on the server. It is never sent to the browser.
# =============================================================================

# --- REQUIRED ----------------------------------------------------------------
# Your Groq API key, from https://console.groq.com/keys (starts with "gsk_").
GROQ_API_KEY = "[PASTE_YOUR_GROQ_API_KEY_HERE]"

# --- OPTIONAL: delete a line to use its default ------------------------------
# Main chat model (must be available to your Groq key).
GROQ_MODEL = "qwen/qwen3.8-27b"

# Tried in order when the main model is rate limited (HTTP 429).
# Each Groq model has its own free-tier budget. "none" disables fallback.
GROQ_FALLBACK_MODELS = "openai/gpt-oss-20b,openai/gpt-oss-120b"

# Who writes the SQL: "vanna" (default) or "native". Both go through the
# same safety guard and read-only database.
TEXT_TO_SQL_PROVIDER = "vanna"
